# Database
DATABASE_URL=postgresql://user:password@localhost:5432/linkdrop

# Public site URL (used for sitemap/robots and canonical URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Auth.js (run: npx auth secret)
AUTH_SECRET=
AUTH_GOOGLE_ID=your-google-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your-google-client-secret
# Google OAuth redirect URIs (Google Cloud Console → Credentials → OAuth Client ID →
# Authorized redirect URIs). Only `localhost` may use http; all other origins require https:
#   http://localhost:3000/api/auth/callback/google
#   https://<your-domain>/api/auth/callback/google
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=linkinbio
R2_PUBLIC_URL=https://pub-<your_pub_id>.r2.dev
NEXT_PUBLIC_R2_HOSTNAME=pub-<your_pub_id>.r2.dev
